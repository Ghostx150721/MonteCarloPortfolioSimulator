@model MonteCarlo.Core.Models.SimulationResult
@using System.Text.Json
@inject Microsoft.AspNetCore.Mvc.Rendering.IHtmlHelper Html

<h2>Results</h2>

<div style="border:1px solid #ccc; padding:10px; margin-bottom:20px;">
    <h3>Investment Summary</h3>
    <p><strong>Worst Case (10%):</strong> @Model.P10.ToString("N0")</p>
    <p><strong>Most Likely (Median):</strong> @Model.P50.ToString("N0")</p>
    <p><strong>Best Case (90%):</strong> @Model.P90.ToString("N0")</p>
</div>

<canvas id="chart"></canvas>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const rawData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.FinalPortfolioValues));

    const percentileValues = [
        @Model.P10,
        @Model.P50,
        @Model.P90
    ];

    const binCount = 30;

    const min = Math.min(...rawData);
    const max = Math.max(...rawData);
    const binSize = (max - min) / binCount;

    const bins = new Array(binCount).fill(0);

    rawData.forEach(value => {
        let index = Math.floor((value - min) / binSize);
        if (index >= binCount) index = binCount - 1;
        bins[index]++;
    });

    const labels = bins.map((_, i) => {
        const start = Math.round(min + i * binSize);
        const end = Math.round(start + binSize);
        return `${start} - ${end}`;
    });

    // ✅ Convert percentile values → bin index
    const percentileIndexes = percentileValues.map(v => {
        let index = Math.floor((v - min) / binSize);
        if (index >= binCount) index = binCount - 1;
        return index;
    });

    const ctx = document.getElementById('chart');

    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [{
                label: 'Distribution',
                data: bins
            }]
        },
        options: {
            scales: {
                x: {
                    ticks: {
                        maxRotation: 90,
                        minRotation: 45
                    }
                }
            }
        },

        // ✅ REGISTER PLUGIN HERE
        plugins: [{
            id: 'percentileLines',
            afterDraw: (chart) => {
                const { ctx, scales: { x, y } } = chart;

                percentileIndexes.forEach((index, i) => {
                    const xPos = x.getPixelForValue(index);

                    ctx.save();
                    ctx.beginPath();
                    ctx.moveTo(xPos, y.top);
                    ctx.lineTo(xPos, y.bottom);
                    ctx.lineWidth = 2;

                    // Different colors for each percentile
                    const colors = ['red', 'green', 'orange'];
                    ctx.strokeStyle = colors[i];

                    ctx.stroke();

                    // Optional label
                    ctx.fillStyle = colors[i];
                    ctx.fillText(['P10', 'P50', 'P90'][i], xPos + 5, y.top + 15);

                    ctx.restore();
                });
            }
        }]
    });
</script>

<h3>Sample Simulation Paths</h3>
<canvas id="pathChart"></canvas>

<script>
    const paths = @Html.Raw(JsonSerializer.Serialize(Model.Paths));

    // take first 20 paths
    const samplePaths = paths.slice(0, 20);

    const datasets = samplePaths.map((path, i) => ({
        label: `Sim ${i + 1}`,
        data: path,
        borderWidth: 1,
        fill: false,
        tension: 0.1
    }));

    new Chart(document.getElementById('pathChart'), {
        type: 'line',
        data: {
            labels: [...Array(samplePaths[0].length).keys()],
            datasets: datasets
        },
        options: {
            plugins: {
                legend: {
                    display: false // cleaner look
                }
            },
            scales: {
                x: {
                    title: {
                        display: true,
                        text: 'Months'
                    }
                },
                y: {
                    title: {
                        display: true,
                        text: 'Portfolio Value'
                    }
                }
            }
        }
    });
</script>
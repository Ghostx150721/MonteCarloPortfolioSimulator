@model MonteCarlo.Core.Models.SimulationResult
@{
    ViewData["Title"] = "Results";
}

@functions {
    string Fmt(double v)
    {
        if (v >= 1_000_000) return $"${v / 1_000_000:F2}M";
        if (v >= 1_000) return $"${v / 1_000:F1}K";
        return $"${v:F0}";
    }
}

<div class="flex h-[calc(100vh-57px)]">

    @* LEFT: re-run sidebar *@
    <aside class="w-64 shrink-0 border-r border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 overflow-y-auto p-5 flex flex-col gap-4">
        <p class="text-xs font-medium uppercase tracking-widest text-gray-400 dark:text-gray-500">Adjust &amp; re-run</p>
        <a asp-controller="Simulation" asp-action="Index"
           class="w-full h-10 flex items-center justify-center rounded-lg border border-gray-200 dark:border-gray-800 text-sm text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
            ← Back to parameters
        </a>
        <p class="text-xs text-gray-400 dark:text-gray-500 mt-2">
            Tweak your inputs and run again to compare different scenarios.
        </p>
    </aside>

    @* RIGHT: results *@
    <div class="flex-1 overflow-y-auto p-6 flex flex-col gap-6">

        <div>
            <h1 class="text-lg font-medium text-gray-900 dark:text-gray-100">Simulation results</h1>
            <p class="text-xs text-gray-400 dark:text-gray-500 mt-0.5">
                @Model.FinalPortfolioValues.Count simulations &middot;
                P10 / P50 / P90 percentile outcomes
            </p>
        </div>

        @* Metric cards *@
        <div class="grid grid-cols-3 gap-3">
            <div class="bg-gray-50 dark:bg-gray-800 rounded-xl p-4">
                <p class="text-xs uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-2">Worst case · P10</p>
                <p class="mono text-2xl font-medium text-red-500">@Fmt(Model.P10)</p>
            </div>
            <div class="bg-gray-50 dark:bg-gray-800 rounded-xl p-4">
                <p class="text-xs uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-2">Median · P50</p>
                <p class="mono text-2xl font-medium text-gray-800 dark:text-gray-100">@Fmt(Model.P50)</p>
            </div>
            <div class="bg-gray-50 dark:bg-gray-800 rounded-xl p-4">
                <p class="text-xs uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-2">Best case · P90</p>
                <p class="mono text-2xl font-medium text-emerald-600">@Fmt(Model.P90)</p>
            </div>
        </div>

        @* Drawdown cards *@
        <div class="grid grid-cols-2 gap-3">
            <div class="bg-gray-50 dark:bg-gray-800 rounded-xl p-4">
                <p class="text-xs uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-2">Worst drawdown</p>
                <p class="mono text-xl font-medium text-red-500">
                    @Model.MaxDrawdowns.Min().ToString("P1")
                </p>
            </div>
            <div class="bg-gray-50 dark:bg-gray-800 rounded-xl p-4">
                <p class="text-xs uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-2">Typical drawdown · median</p>
                <p class="mono text-xl font-medium text-red-400">
                    @Model.MaxDrawdowns.OrderBy(x => x).ElementAt(Model.MaxDrawdowns.Count / 2).ToString("P1")
                </p>
            </div>
        </div>

        <div class="bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-800 rounded-xl p-5">
            <p class="text-xs uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-4">Final value distribution</p>
            <div class="relative h-48">
                <canvas id="distChart"></canvas>
            </div>
        </div>

        @* Paths chart *@
        <div class="bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-800 rounded-xl p-5">
            <p class="text-xs uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-4">Sample simulation paths</p>
            <div class="relative h-48">
                <canvas id="pathChart"></canvas>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script>
        const finals = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.FinalPortfolioValues));
        const paths  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Paths));

        const p10 = @Model.P10;
        const p50 = @Model.P50;
        const p90 = @Model.P90;

        function fmtK(v) {
            if (v >= 1e6) return '$' + (v/1e6).toFixed(2) + 'M';
            if (v >= 1e3) return '$' + (v/1e3).toFixed(1) + 'K';
            return '$' + Math.round(v);
        }

        // --- Distribution chart ---
        const binCount = 30;
        const sorted = [...finals].sort((a,b) => a-b);
        const minV = sorted[0], maxV = sorted[sorted.length-1];
        const binSize = (maxV - minV) / binCount;

        const bins = new Array(binCount).fill(0);
        finals.forEach(v => {
            let i = Math.floor((v - minV) / binSize);
            if (i >= binCount) i = binCount - 1;
            bins[i]++;
        });

        const toIdx = v => Math.min(binCount-1, Math.floor((v - minV) / binSize));
        const p10i = toIdx(p10), p50i = toIdx(p50), p90i = toIdx(p90);

        const labels = bins.map((_, i) => fmtK(minV + i * binSize));

        new Chart(document.getElementById('distChart'), {
            type: 'bar',
            data: {
                labels,
                datasets: [{
                    label: 'Simulations',
                    data: bins,
                    backgroundColor: bins.map((_, i) => {
                        if (i === p10i) return '#EF4444';
                        if (i === p50i) return '#6B7280';
                        if (i === p90i) return '#10B981';
                        return 'rgba(59,130,246,0.25)';
                    }),
                    borderWidth: 0,
                    borderRadius: 3
                }]
            },
            plugins: [{
                id: 'pLines',
                afterDraw(chart) {
                    const { ctx, scales: { x, y } } = chart;
                    [[p10i,'#EF4444','P10'],[p50i,'#6B7280','P50'],[p90i,'#10B981','P90']].forEach(([idx,color,lbl]) => {
                        const xp = x.getPixelForValue(idx);
                        ctx.save();
                        ctx.beginPath();
                        ctx.moveTo(xp, y.top);
                        ctx.lineTo(xp, y.bottom);
                        ctx.lineWidth = 1.5;
                        ctx.setLineDash([4,3]);
                        ctx.strokeStyle = color;
                        ctx.stroke();
                        ctx.setLineDash([]);
                        ctx.font = '11px JetBrains Mono, monospace';
                        ctx.fillStyle = color;
                        ctx.fillText(lbl, xp + 4, y.top + 14);
                        ctx.restore();
                    });
                }
            }],
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { ticks: { maxTicksLimit: 6, font: { size: 10 }, maxRotation: 45 }, grid: { color: '#F3F4F6' } },
                    y: { ticks: { font: { size: 10 }, callback: v => v }, grid: { color: '#F3F4F6' } }
                }
            }
        });

        // --- Paths chart ---
        const sample = paths.slice(0, 20);
        const monthLabels = Array.from({ length: sample[0].length }, (_, i) => i + 1);

        new Chart(document.getElementById('pathChart'), {
            type: 'line',
            data: {
                labels: monthLabels,
                datasets: sample.map((path, i) => ({
                    data: path,
                    borderWidth: 1,
                    borderColor: i === 0 ? 'rgba(59,130,246,0.6)' : 'rgba(59,130,246,0.15)',
                    pointRadius: 0,
                    fill: false,
                    tension: 0.2
                }))
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: {
                        ticks: { maxTicksLimit: 10, font: { size: 10 } },
                        grid: { color: '#F3F4F6' },
                        title: { display: true, text: 'Month', font: { size: 11 }, color: '#9CA3AF' }
                    },
                    y: {
                        ticks: { font: { size: 10 }, callback: v => fmtK(v) },
                        grid: { color: '#F3F4F6' }
                    }
                },
                animation: { duration: 600 }
            }
        });
    </script>
}
@model MonteCarlo.Web.Models.SimulationInputModel

<h2>Monte Carlo Simulator</h2>

<button type="button" onclick="setConservative()">Conservative</button>
<button type="button" onclick="setAggressive()">Aggressive</button>

<script>
    function setConservative() {
        const returnSlider = document.querySelector('[name="MeanAnnualReturn"]');
        const volSlider = document.querySelector('[name="Volatility"]');

        returnSlider.value = 0.06;
        volSlider.value = 0.1;

        returnSlider.dispatchEvent(new Event('input'));
        volSlider.dispatchEvent(new Event('input'));
    }

    function setAggressive() {
        const returnSlider = document.querySelector('[name="MeanAnnualReturn"]');
        const volSlider = document.querySelector('[name="Volatility"]');

        returnSlider.value = 0.10;
        volSlider.value = 0.2;

        returnSlider.dispatchEvent(new Event('input'));
        volSlider.dispatchEvent(new Event('input'));
    }
</script>

<form method="post" asp-action="Run">

    <label>Initial Investment:</label>
    <input asp-for="InitialInvestment" /><br />

    <label>Monthly Contribution:</label>
    <input asp-for="MonthlyContribution" /><br />

    <label>Years:</label>
    <input asp-for="Years" /><br />

    <label>Expected Return (8%):</label>
    <input asp-for="MeanAnnualReturn"/><br />

    <label>Volatility (0.15 = 15%):</label>
    <input asp-for="Volatility"/><br />

    <label>Simulation Count:</label>
    <input asp-for="SimulationCount" /><br />

    <label>Crash Probability (yearly):</label>
    <input type="range" min="0.0" max="0.5" step="0.01"
           asp-for="CrashProbabilityPerYear" 
           oninput="this.nextElementSibling.textContent = this.value" />
    <output>@Model.CrashProbabilityPerYear</output>
    <br />

    <label>Crash Impact (-0.4 = -40%):</label>
    <input asp-for="CrashImpact" /><br />

    <br />

    <label>Simulation Model:</label>
    <select asp-for="ModelType">
        <option value="Real">Real Market (S&P 500)</option>
        <option value="GBM">Theoretical (Normal Distribution)</option>
    </select>
    <br />

    <button type="submit">Run Simulation</button>

    <button type="submit" formaction="/Simulation/Compare">
        Compare Strategies
    </button>

    <p id="loading" style="display:none;">Running simulation...</p>

    <script>
        function showLoading() {
            document.getElementById("loading").style.display = "block";
        }
    </script>

</form>